<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alibaba EagleEye-style logback configuration template.

  Placeholders (must be replaced before use):
    {APP_NAME}        e.g. happyhorse            — 应用名，用于日志目录
    {EXTERNAL_NAME}   e.g. bailian / openai      — 外部服务名，用于 digest 文件
                      如有多个外部服务，复制 BAILIAN_DIGEST_FILE/BAILIAN_DIGEST
                      两块 appender，重命名为 OPENAI_DIGEST_FILE/OPENAI_DIGEST

  配套 application.yml：
    {APP_NAME}:
      log:
        path: ${user.home}/logs/{APP_NAME}
        max-file-size: 100MB
        max-history-days: 7
        total-size-cap: 2GB
-->
<configuration scan="true" scanPeriod="30 seconds">

  <!-- 从 application.yml 读取，避免硬编码 -->
  <springProperty scope="context" name="LOG_HOME"      source="{APP_NAME}.log.path"              defaultValue="${user.home}/logs/{APP_NAME}"/>
  <springProperty scope="context" name="MAX_FILE_SIZE" source="{APP_NAME}.log.max-file-size"     defaultValue="100MB"/>
  <springProperty scope="context" name="MAX_HISTORY"   source="{APP_NAME}.log.max-history-days"  defaultValue="7"/>
  <springProperty scope="context" name="TOTAL_CAP"     source="{APP_NAME}.log.total-size-cap"    defaultValue="2GB"/>

  <!-- 统一主格式 -->
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{traceId:-},%X{rpcId:-}] [%thread] %logger{36} - %msg%n"/>

  <!-- Digest 格式（pipe 分隔，消息内容已由 DigestLogger 拼好） -->
  <property name="DIGEST_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS}|%X{traceId:-}|%X{rpcId:-}|%msg%n"/>

  <!-- ========== 控制台（开发用） ========== -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- ========== application.log ========== -->
  <appender name="APPLICATION_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/application.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/%d{yyyy-MM-dd}/application.%i.log</fileNamePattern>
      <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
      <maxHistory>${MAX_HISTORY}</maxHistory>
      <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="APPLICATION" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="APPLICATION_FILE"/>
    <queueSize>512</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
    <maxFlushTime>1000</maxFlushTime>
    <includeCallerData>false</includeCallerData>
  </appender>

  <!-- ========== error.log ========== -->
  <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/error.log</file>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>WARN</level>
    </filter>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/%d{yyyy-MM-dd}/error.%i.log</fileNamePattern>
      <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
      <maxHistory>${MAX_HISTORY}</maxHistory>
      <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="ERROR" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="ERROR_FILE"/>
    <queueSize>256</queueSize>
    <discardingThreshold>-1</discardingThreshold>
    <neverBlock>false</neverBlock>
    <maxFlushTime>1000</maxFlushTime>
    <includeCallerData>true</includeCallerData>
  </appender>

  <!-- ========== access.log ========== -->
  <appender name="ACCESS_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/access.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/%d{yyyy-MM-dd}/access.%i.log</fileNamePattern>
      <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
      <maxHistory>${MAX_HISTORY}</maxHistory>
      <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${DIGEST_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="ACCESS" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="ACCESS_FILE"/>
    <queueSize>1024</queueSize>
    <discardingThreshold>0</discardingThreshold>
    <neverBlock>false</neverBlock>
    <maxFlushTime>1000</maxFlushTime>
    <includeCallerData>false</includeCallerData>
  </appender>

  <!-- ========== {EXTERNAL_NAME}-digest.log（按需复制重命名） ========== -->
  <appender name="{EXTERNAL_NAME}_DIGEST_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/{EXTERNAL_NAME}-digest.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/%d{yyyy-MM-dd}/{EXTERNAL_NAME}-digest.%i.log</fileNamePattern>
      <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
      <maxHistory>${MAX_HISTORY}</maxHistory>
      <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${DIGEST_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="{EXTERNAL_NAME}_DIGEST" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="{EXTERNAL_NAME}_DIGEST_FILE"/>
    <queueSize>256</queueSize>
    <discardingThreshold>-1</discardingThreshold>
    <neverBlock>false</neverBlock>
    <maxFlushTime>1000</maxFlushTime>
    <includeCallerData>false</includeCallerData>
  </appender>

  <!-- ========== task-digest.log（有异步任务时启用） ========== -->
  <appender name="TASK_DIGEST_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_HOME}/task-digest.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_HOME}/%d{yyyy-MM-dd}/task-digest.%i.log</fileNamePattern>
      <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
      <maxHistory>${MAX_HISTORY}</maxHistory>
      <totalSizeCap>${TOTAL_CAP}</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${DIGEST_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <appender name="TASK_DIGEST" class="ch.qos.logback.classic.AsyncAppender">
    <appender-ref ref="TASK_DIGEST_FILE"/>
    <queueSize>256</queueSize>
    <discardingThreshold>-1</discardingThreshold>
    <neverBlock>false</neverBlock>
    <maxFlushTime>1000</maxFlushTime>
    <includeCallerData>false</includeCallerData>
  </appender>

  <!-- ========== Loggers ========== -->

  <!-- Digest loggers：additivity=false，避免重复落 application -->
  <logger name="ACCESS_LOG" level="INFO" additivity="false">
    <appender-ref ref="ACCESS"/>
  </logger>

  <logger name="{EXTERNAL_NAME_UPPER}_DIGEST" level="INFO" additivity="false">
    <appender-ref ref="{EXTERNAL_NAME}_DIGEST"/>
  </logger>

  <logger name="TASK_DIGEST" level="INFO" additivity="false">
    <appender-ref ref="TASK_DIGEST"/>
  </logger>

  <!-- 业务包日志级别 -->
  <logger name="com" level="INFO"/>
  <logger name="org.springframework" level="WARN"/>

  <!-- Root：主日志 + 错误日志 + 开发环境控制台 -->
  <springProfile name="dev | default">
    <root level="INFO">
      <appender-ref ref="CONSOLE"/>
      <appender-ref ref="APPLICATION"/>
      <appender-ref ref="ERROR"/>
    </root>
  </springProfile>

  <springProfile name="prod">
    <root level="INFO">
      <appender-ref ref="APPLICATION"/>
      <appender-ref ref="ERROR"/>
    </root>
  </springProfile>

</configuration>
